PORT=4000
FRONTEND_URL=http://localhost:5173
SECRET=replace-with-a-long-random-value
ACCOUNT_EMAIL_ENABLED=false
BREVO_API_KEY=your-brevo-api-key
AUTH_EMAIL_FROM=your-address@gmail.com
GOOGLE_CLIENT_ID=your-web-oauth-client-id.apps.googleusercontent.com
DB_HOST=replace-with-mysql-host
DB_PORT=4000
DB_USER=replace-with-mysql-user
DB_PASS=replace-with-mysql-password
DB_NAME=innovest
# Use DB_SSL_ENABLED=true for system-CA TLS (e.g., TiDB Cloud Starter on Render Docker).
# Or set DB_SSL_CA / DB_SSL_CA_PATH when supplying a custom CA certificate file.
DB_SSL_ENABLED=true
DB_SSL_CA_PATH=./certs/ca.pem
